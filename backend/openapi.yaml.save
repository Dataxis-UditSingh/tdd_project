openapi: 3.0.3

info:
  title: TDD Challenge API
  version: 1.0.0
  description: API for the TDD Challenge application

servers:
  - url: http://localhost:4000

paths:
  /api/health:
    get:
      operationId: getHealth
      responses:
        "200":
          description: API is healthy

  /api/challenges:
    get:
      operationId: listChallenges
      responses:
        "200":
          description: List of challenges

  /api/challenges/{id}:
    get:
      operationId: getChallenge
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Challenge det

